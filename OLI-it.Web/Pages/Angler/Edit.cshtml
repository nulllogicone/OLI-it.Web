@page "/angler/{id:guid}/edit"
@model OLI_it.Web.Pages.Angler.EditModel
@{
    ViewData["Title"] = "Edit Angler";
}

<div class="content-section">
    <h1>Edit Angler</h1>
    <form method="post" class="postit-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <partial name="_AnglerFields" for="Input" />
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-page="/Angler/Index" asp-route-id="@Model.Angler.AnglerGuid" class="btn btn-secondary">Cancel</a>
    </form>
</div>
