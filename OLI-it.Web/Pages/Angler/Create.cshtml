@page "/angler/create"
@model OLI_it.Web.Pages.Angler.CreateModel
@{
    ViewData["Title"] = "New Angler";
}

<div class="content-section">
    <h1>New Angler</h1>
    <form method="post" class="postit-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <partial name="_AnglerFields" for="Input" />
        <button type="submit" class="btn btn-primary">Create Angler</button>
        <a asp-page="/Stamm/Angler" asp-route-id="@Model.Stamm.StammGuid" class="btn btn-secondary">Cancel</a>
    </form>
</div>
