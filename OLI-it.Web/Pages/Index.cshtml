@page
@model IndexModel
@{
    string T(string key) => OLI_it.Web.Localization.SharedText.Get(key);
    string TFmt(string key, params object[] args) => OLI_it.Web.Localization.SharedText.Get(key, args);
    ViewData["Title"] = T("HomePageTitle");
}

<div class="page-header">
    <h1>OLI-it</h1>
    <p>@T("HomePageTagline")</p>
</div>

<div class="content-section">
    <div class="intro-text">
        <p>@T("HomeIntroParagraph1")</p>
        <p>@T("HomeIntroParagraph2")</p>
    </div>

    <div class="feature-highlight">
        <h2>@T("HomeFeatureHeadline")</h2>
        <p>@T("HomeFeatureSubline")</p>

        <div class="feature-list">
            <h3>@T("HomeFeatureListTitle")</h3>
            <ul>
                <li>@T("HomeFeatureItem1")</li>
                <li>@T("HomeFeatureItem2")</li>
                <li>@T("HomeFeatureItem3")</li>
                <li>@T("HomeFeatureItem4")</li>
            </ul>
        </div>
    </div>

    @if (Model.StammList.Any())
    {
        <div class="stamm-list">
            <h3>@T("RecentUsers")</h3>
            <table class="simple-table">
                <thead>
                    <tr>
                        <th>@T("Thumbnail")</th>
                        <th>@T("Name")</th>
                        <th>@T("Email")</th>
                        <th>@T("RegistrationDate")</th>
                        <th>@T("ImagePath")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stamm in Model.StammList.Take(20))
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(stamm.Datei))
                                {
                                    @await Component.InvokeAsync("ImageThumbnail", new { dateiPath = stamm.Datei, altText = TFmt("StammImageAltText", stamm.Stamm1), width = 80, height = 80 })
                                }
                            </td>
                            <td>@stamm.Stamm1</td>
                            <td>@stamm.EMail</td>
                            <td>@stamm.Datum.ToShortDateString()</td>
                            <td>@(stamm.Datei ?? T("NoneValue"))</td>
                            <td>
                                <a href="/stamm/@stamm.StammGuid">@T("View")</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
