@page "/postit/create"
@model OLI_it.Web.Pages.PostIt.CreateModel
@{
    ViewData["Title"] = "New message";
}
<div class="content-section">
    <h1>New message</h1>
    <p>Write a message as <strong>@Model.Stamm?.Stamm1</strong>.</p>
    <p>Saving transfers 1 KooK from your account to the message and sets a 10-day deadline.
        The message starts with an additional 0.01 Flow-KooK.</p>

    <form method="post" class="postit-form">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="Submission" type="hidden" />
        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label">Title</label>
            <input asp-for="Input.Title" class="form-control" maxlength="255" required />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Body" class="form-label">Message</label>
            <textarea asp-for="Input.Body" class="form-control" rows="8" maxlength="3000" required aria-describedby="message-format"></textarea>
            <small id="message-format">Plain text. Special characters count toward the shared database's encoded length limit.</small>
            <span asp-validation-for="Input.Body" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Url" class="form-label">Link (optional)</label>
            <input asp-for="Input.Url" class="form-control" type="url" maxlength="255" placeholder="https://example.com" />
            <span asp-validation-for="Input.Url" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save message</button>
        <a href="/stamm/@Model.Stamm?.StammGuid/postit" class="btn btn-secondary">Cancel</a>
    </form>
</div>
