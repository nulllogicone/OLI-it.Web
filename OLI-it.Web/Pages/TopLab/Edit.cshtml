@page "/toplab/{id:guid}/edit"
@model OLI_it.Web.Pages.TopLab.EditModel
@{
    ViewData["Title"] = "Edit answer";
}

<div class="content-section">
    <h1>Edit answer</h1>
    <form method="post" enctype="multipart/form-data" class="postit-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        @if (Model.Answer.Typ.Trim() != "txt")
        {
            <p>Changing the answer text saves it as plain text.</p>
        }
        <partial name="_AnswerFields" for="Input" />
        <div class="mb-3">
            @await Component.InvokeAsync("ImageGallery", new
            {
                stammGuid = Model.Answer.StammGuid,
                currentImage = Model.DateiUpload == null ? Model.SelectedImageUrl ?? Model.Answer.Datei : null
            })
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-page="/TopLab/Index" asp-route-id="@Model.Answer.TopLabGuid" class="btn btn-secondary">Cancel</a>
    </form>
</div>
