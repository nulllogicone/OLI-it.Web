@page "{id:guid}"
@model OLI_it.Web.Pages.TopLab.IndexModel
@using System.Text.Json
@{
    var topLabTitle = Model.TopLab?.Titel ?? "Answer";
    var topLabBody = Model.TopLab?.TopLab1 ?? "";
    var topLabDesc = topLabBody.Length > 160 ? topLabBody[..157] + "…" : topLabBody;
    ViewData["Title"] = topLabTitle;
    ViewData["Description"] = topLabDesc;
    ViewData["CanonicalUrl"] = $"https://oli-it.com/toplab/{Model.TopLab?.TopLabGuid}";
    ViewData["OgType"] = "article";
}

<div class="browse-container">
    <div class="entity-stack">
        @if (Model.Stamm != null)
        {
            @await Html.PartialAsync("_StammCard", Model.Stamm)
        }

        @if (Model.PostIt != null)
        {
            ViewData["StammGuid"] = Model.Stamm?.StammGuid.ToString() ?? "";
            @await Html.PartialAsync("_PostItCard", Model.PostIt)
        }

        @if (Model.TopLab != null)
        {
            ViewData["StammGuid"] = Model.Stamm?.StammGuid.ToString() ?? "";
            @await Html.PartialAsync("_TopLabCard", Model.TopLab)
        }
    </div>
</div>

@section Head {
    @if (Model.TopLab != null)
    {
        var jsonText = JsonSerializer.Serialize(Model.TopLab.TopLab1);
        var topLabUrl = $"https://oli-it.com/toplab/{Model.TopLab.TopLabGuid}";
        var parentPostItBlock = Model.PostIt != null
            ? $",\n          \"parentItem\": {{\n            \"@@type\": \"DiscussionForumPosting\",\n            \"headline\": {JsonSerializer.Serialize(Model.PostIt.Titel ?? "PostIt")},\n            \"url\": \"https://oli-it.com/postit/{Model.PostIt.PostItGuid}\"\n          }}"
            : "";
        var authorBlock = Model.Stamm != null
            ? $",\n          \"author\": {{\n            \"@@type\": \"Person\",\n            \"name\": {JsonSerializer.Serialize(Model.Stamm.Stamm1)},\n            \"url\": \"https://oli-it.com/stamm/{Model.Stamm.StammGuid}\"\n          }}"
            : "";
        <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Comment",
          "text": @Html.Raw(jsonText),
          "datePublished": "@Model.TopLab.Datum.ToString("yyyy-MM-dd")",
          "url": "@topLabUrl"@Html.Raw(authorBlock)@Html.Raw(parentPostItBlock)
        }
        </script>
    }
}
