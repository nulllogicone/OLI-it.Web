@model List<OLI_it.Web.Models.Spiegel>

@if (Model?.Any() == true)
{
    <div class="catched-postits-list">
        @foreach (var news in Model)
        {
            var postIt = news.Code?.PostIt;
            var postItGuid = news.Code?.PostItGuid;

            <article class="entity-card postit-card sticky-note catched-postit-card">
                @if (!string.IsNullOrEmpty(postIt?.Datei))
                {
                    @if (postItGuid.HasValue)
                    {
                        <a href="/postit/@postItGuid" class="postit-thumb-float">
                            @await Component.InvokeAsync("ImageThumbnail", new { dateiPath = postIt.Datei, altText = $"PostIt {postIt.Titel ?? "Untitled"} Image", width = 72, height = 72 })
                        </a>
                    }
                    else
                    {
                        <div class="postit-thumb-float">
                            @await Component.InvokeAsync("ImageThumbnail", new { dateiPath = postIt.Datei, altText = $"PostIt {postIt.Titel ?? "Untitled"} Image", width = 72, height = 72 })
                        </div>
                    }
                }
                else
                {
                    <div class="postit-thumb-float postit-thumb-placeholder" aria-hidden="true"></div>
                }

                <div class="card-meta-box postit-meta-float">
                    <div class="card-meta-datum">@((news.Zeit ?? postIt?.Datum)?.ToString("dd MMM yyyy") ?? "-")</div>
                    @if (postIt != null)
                    {
                        <div class="card-meta-value">@postIt.KooK.ToString("N")</div>
                        <div class="card-meta-value">@postIt.Hits <small>hits</small></div>
                    }
                </div>

                <h3 class="postit-title">
                    @if (postItGuid.HasValue)
                    {
                        <a href="/postit/@postItGuid">@(postIt?.Titel ?? "Unknown")</a>
                    }
                    else
                    {
                        @(postIt?.Titel ?? "Unknown")
                    }
                </h3>

                @if (!string.IsNullOrEmpty(postIt?.PostIt1))
                {
                    <div class="postit-body">
                        <div class="entity-description">
                            @postIt.PostIt1
                        </div>
                    </div>
                }

                <div class="catched-postit-meta">
                    <span>Code: @(news.Code?.Kommentar ?? "-")</span>
                    @if (!string.IsNullOrWhiteSpace(news.Status))
                    {
                        <span>Status: @news.Status</span>
                    }
                    @if (news.Zeit.HasValue)
                    {
                        <span>Matched: @news.Zeit.Value.ToString("yyyy-MM-dd HH:mm")</span>
                    }
                    @if (news.Gelesen.HasValue)
                    {
                        <span>Read: @news.Gelesen.Value.ToString("yyyy-MM-dd HH:mm")</span>
                    }
                </div>

                <div class="postit-clearfix"></div>
            </article>
        }
    </div>
}
else
{
    <p class="no-data">No catched PostIts found.</p>
}
