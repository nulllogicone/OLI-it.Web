@model List<OLI_it.Web.Models.News>

@if (Model?.Any() == true)
{
    <table class="simple-table postit-table">
        <thead>
            <tr>
                <th>Thumbnail</th>
                <th>Title</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var news in Model)
            {
                var targetUrl = news.Code?.PostItGuid != null ? $"/postit/{news.Code.PostItGuid}" : null;
                <tr class="sticky-note-row" tabindex="@(targetUrl != null ? "0" : null)" role="@(targetUrl != null ? "link" : null)" style="@(targetUrl != null ? "cursor:pointer" : null)" onclick="@(targetUrl != null ? $"window.location='{targetUrl}'" : null)" onkeydown="@(targetUrl != null ? $"if (event.key === 'Enter' || event.key === ' ') {{ event.preventDefault(); window.location='{targetUrl}'; }}" : null)">
                    <td>
                        @if (!string.IsNullOrEmpty(news.Code?.PostIt?.Datei))
                        {
                            @await Component.InvokeAsync("ImageThumbnail", new { dateiPath = news.Code.PostIt.Datei, altText = $"PostIt {news.Code.PostIt.Titel ?? "Untitled"} Image", width = 80, height = 80 })
                        }
                    </td>
                    <td>@(news.Code?.PostIt?.Titel ?? "Unknown")</td>
                    <td>@(news.Code?.PostIt?.PostIt1 ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="no-data">No catched PostIts found.</p>
}
