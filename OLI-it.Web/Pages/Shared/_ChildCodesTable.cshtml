@model List<OLI_it.Web.Models.Code>

@if (Model?.Any() == true)
{
    <table class="simple-table">
        <thead>
            <tr>
                <th>Comment</th>
                <th>Status</th>
                <th>Scanned</th>
                <th>Receivers</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var code in Model)
            {
                var receiversCount = code.Spiegels?.Count ?? 0;
                var targetUrl = $"/code/{code.CodeGuid}";
                <tr class="code-row" tabindex="0" role="link" onclick="window.location='@targetUrl'" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); window.location='@targetUrl'; }">
                    <td>@code.Kommentar</td>
                    <td>@(code.CodeZust?.ToString() ?? "-")</td>
                    <td>@(code.Gescannt ? "Yes" : "No")</td>
                    <td><span class="count-badge">@receiversCount</span></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="no-data">No Codes found.</p>
}
