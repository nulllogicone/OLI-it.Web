@model OLI_it.Web.Models.TopLab
@using OLI_it.Web.Services
@using System.Security.Claims

<div class="entity-card toplab-card">
    <div class="entity-card-header">
        <div class="header-left-content">
            @if (!string.IsNullOrEmpty(Model.Datei))
            {
                <div class="header-thumbnail">
                    @await Component.InvokeAsync("ImageThumbnail", new { dateiPath = Model.Datei, altText = $"TopLab {Model.Titel ?? "Untitled"} Image", width = 60, height = 60 })
                </div>
            }
            <h3>@PostItText.Title(Model.Titel ?? "Untitled Answer")</h3>
        </div>
        <div class="card-meta-box">
            <div class="card-meta-datum">@Model.Datum.ToString("dd MMM yyyy")</div>
            <div class="card-meta-value">@Model.Lohn.ToString("N")</div>
        </div>
        <div class="card-actions-top-right">
            @if (User.Identity?.IsAuthenticated == true &&
                Guid.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var authorId) &&
                authorId == Model.StammGuid)
            {
                <a asp-page="/TopLab/Edit" asp-route-id="@Model.TopLabGuid" class="edit-btn"
                   title="Edit answer" aria-label="Edit answer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                    </svg>
                </a>
            }
            <a href="/postit/@Model.PostItGuid" class="close-btn" title="Close to PostIt">&times;</a>
        </div>
    </div>
    <div class="entity-card-body">
        <div class="entity-description">
            @PostItText.Body(Model.TopLab1, Model.Typ)
        </div>
        @if (!string.IsNullOrEmpty(Model.Url))
        {
            <div class="entity-link">
                <a href="@Model.Url" target="_blank">@Model.Url</a>
            </div>
        }
    </div>
</div>

