@model OLI_it.Web.ViewComponents.ImageThumbnailViewModel

@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <div class="image-thumbnail" title="@Model.ImageUrl">
        <img src="@Model.ImageUrl" 
             alt="@Model.AltText" 
             width="@Model.Width" 
             height="@Model.Height"
             class="thumbnail-img"
             loading="lazy" />
    </div>
}
