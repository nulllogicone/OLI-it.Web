@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
}

<nav class="sidebar-menu">
    <ul class="menu-list">
        @* Anonymous user menu items *@
        @if (!isAuthenticated)
        {
            <li class="menu-item">
                <a href="/register" class="@(currentPage.Contains("Register") ? "active" : "")">
                    register
                </a>
                <span class="menu-description">absolute free</span>
            </li>
        }
        <li class="menu-item">
            <a href="/journal" class="@(currentPage.Contains("Journal") ? "active" : "")">
                timeline
            </a>
            <span class="menu-description">latest messages</span>
        </li>
        <li class="menu-item">
            <a href="/charts" class="@(currentPage.Contains("Charts") ? "active" : "")">
                chart
            </a>
            <span class="menu-description">statistical overview</span>
        </li>
        <li class="menu-item">
            <a href="/search" class="@(currentPage.Contains("Search") ? "active" : "")">
                search
            </a>
            <span class="menu-description">for users, messages or answers</span>
        </li>
        <li class="menu-item">
            <a href="/wortraum" class="@(currentPage.Contains("Wortraum") ? "active" : "")">
                wortraum
            </a>
            <span class="menu-description">word space hierarchy</span>
        </li>
        <li class="menu-item">
            <a href="/links">
                more links
            </a>
        </li>
        <li class="menu-item">
            <a href="/imprint" class="@(currentPage.Contains("Imprint") ? "active" : "")">
                imprint
            </a>
        </li>
    </ul>
</nav>
