@model List<OLI_it.Web.Models.Angler>
@{
    var anglerCatchCounts = ViewData["AnglerCatchCounts"] as IReadOnlyDictionary<Guid, int>;
}

@if (Model?.Any() == true)
{
    <table class="simple-table stamm-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Date</th>
                <th>Scanned</th>
                <th>Catches</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var angler in Model)
            {
                var catchesCount = (anglerCatchCounts != null && anglerCatchCounts.TryGetValue(angler.AnglerGuid, out var count)) ? count : 0;
                var targetUrl = $"/angler/{angler.AnglerGuid}";
                <tr class="trunk-row" tabindex="0" role="link" onclick="window.location='@targetUrl'" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); window.location='@targetUrl'; }">
                    <td>@angler.Angler1</td>
                    <td>@angler.Datum.ToString("yyyy-MM-dd")</td>
                    <td>@(angler.Gescannt ? "Yes" : "No")</td>
                    <td><span class="count-badge">@catchesCount</span></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="no-data">No Anglers found.</p>
}
