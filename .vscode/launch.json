{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OLI-it.Web (LocalDB)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build web app",
      "program": "${workspaceFolder}/OLI-it.Web/bin/Debug/net10.0/OLI-it.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/OLI-it.Web",
      "stopAtEntry": false,
      "launchSettingsProfile": "https",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "OLI-it.Web (Azure test)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build web app",
      "program": "${workspaceFolder}/OLI-it.Web/bin/Debug/net10.0/OLI-it.Web.dll",
      "cwd": "${workspaceFolder}/OLI-it.Web",
      "launchSettingsProfile": "azure-test",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
